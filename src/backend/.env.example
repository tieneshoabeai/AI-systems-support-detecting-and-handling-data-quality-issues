# ==============================================================================
# 1. CẤU HÌNH SERVER & ỨNG DỤNG
# ==============================================================================
PORT=3000
NODE_ENV=development
APP_NAME="AI Data Quality Platform"
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173
# URL gốc của ứng dụng web — dùng cho link trong email (lời mời workspace, xem báo cáo)
APP_URL=http://localhost:5173

# Cấu hình Cloudflare Zero Trust Tunnel & SSL/TLS (HTTPS Cổng 443)
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARE_PROXY_TRUST=true
CLOUDFLARE_TUNNEL_URL=
SSL_ENABLED=false
SSL_PORT=443
SSL_KEY_PATH=certs/privkey.pem
SSL_CERT_PATH=certs/fullchain.pem

# ==============================================================================
# 2. MONGODB ATLAS (Cloud Document Database)
# ==============================================================================
MONGODB_URI=mongodb+srv://user_demo:password_demo@cluster0.abcde.mongodb.net/test-ai-system-jsts-db?retryWrites=true&w=majority

# ==============================================================================

# ==============================================================================
# 4. CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible Storage)
# ==============================================================================
# Để trống S3_ENDPOINT nếu muốn chạy LOCAL FALLBACK MODE (lưu tại src/backend/storage)
S3_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_s3_or_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_or_r2_secret_access_key
S3_BUCKET_NAME=test-ai-system-storage
S3_REGION=auto

# ==============================================================================
# 5. BẢO MẬT XÁC THỰC (JWT) & MẬT MÃ
# ==============================================================================
JWT_ACCESS_SECRET=your_super_secret_access_key_at_least_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_at_least_32_characters_long
JWT_REFRESH_EXPIRATION=7d
# Hạn phiên khi chọn "ghi nhớ đăng nhập" (remember me)
JWT_REFRESH_REMEMBER_EXPIRATION=30d
SALT_ROUNDS=12
DATA_ENCRYPTION_KEY=your_64_hex_chars_aes_256_gcm_master_key_here

# ==============================================================================
# 6. GOOGLE GEMINI API (AI Engine Tier 3)
# ==============================================================================
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ==============================================================================
# 6b. GOOGLE OAUTH 2.0 — ĐĂNG NHẬP BẰNG GOOGLE (AUTH-03)
# ==============================================================================
# Cả 3 biến phải có đồng thời thì `GET /auth/google` mới hoạt động.
# Thiếu bất kỳ biến nào → endpoint trả 501 DEPENDENCY_UNAVAILABLE.
#
# LƯU Ý QUAN TRỌNG (2026-11-18): backend đăng ký middleware `cookie-parser` để đọc
# cookie HttpOnly `google_oauth_state` (đối chiếu CSRF ở `GET /auth/google/callback`).
# Cookie này KHÔNG dùng `SameSite=None` nên không cần cấu hình `SameSite`/`Secure` ở đây —
# `secure` được suy ra từ `req.secure` (tôn trọng `trust proxy` khi qua Cloudflare Tunnel).
# Nếu đăng nhập Google báo 401 "Phiên đăng nhập Google không hợp lệ", kiểm tra:
#   - `main.ts` có `app.use(cookieParser())` không (bắt buộc),
#   - `CLOUDFLARE_PROXY_TRUST=true` khi chạy qua tunnel để `req.secure` đúng,
#   - `GOOGLE_REDIRECT_URI` khớp chính xác với URI đã đăng ký ở Google Console.
#
# Cách lấy credential:
#   1. Vào https://console.cloud.google.com/apis/credentials
#   2. Tạo "OAuth 2.0 Client ID" > loại "Web application"
#   3. Thêm Authorized redirect URI, ví dụ:
#        http://localhost:3000/api/v1/auth/google/callback   (dev)
#        https://<your-domain>/api/v1/auth/google/callback  (prod — Google BẮT BUỘC HTTPS)
#   4. Dán Client ID / Client Secret vào dưới đây
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# ==============================================================================
# 7. IN-APP REALTIME (WEBSOCKET / SOCKET.IO)
# ==============================================================================
SOCKET_ENABLED=true

# ==============================================================================
# 8. EMAIL ALERTING (SMTP VIA NODEMAILER)
# ==============================================================================
# Dùng Gmail: bật 2FA → tạo App Password (16 ký tự) tại
# https://myaccount.google.com/apppasswords → dán vào SMTP_PASS (bỏ khoảng trắng).
# Thiếu cấu hình → adapter fail an toàn (log cảnh báo, không crash app).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Data Quality Platform <noreply@data-quality.local>"

# ==============================================================================
# 9. PUSH NOTIFICATION (NTFY.SH)
# ==============================================================================
# Topic là kênh công khai — dùng token để giữ bí mật:
# https://ntfy.sh/<topic> → "Create token" → Access token.
NTFY_ENABLED=false
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=data_quality_alerts_demo
NTFY_ACCESS_TOKEN=
NTFY_REQUEST_TIMEOUT_MS=5000

# 10. Bootstrap (xóa hết DB + seed): CONFIRM_RESET=DROP_ALL_DATA pnpm run db:bootstrap
# =============================================================================
ORGANIZATION_ID=556d6a37bcf86cd799439013
OWNER_EMAIL=admin@school.local
OWNER_PASSWORD=Admin@123