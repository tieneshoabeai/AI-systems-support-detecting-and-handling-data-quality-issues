# ==============================================================================
# 1. CẤU HÌNH SERVER & ỨNG DỤNG
# ==============================================================================
PORT=3000
NODE_ENV=development
APP_NAME="AI Data Quality Platform"
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Cấu hình Cloudflare Zero Trust Tunnel & SSL/TLS (HTTPS Cổng 443)
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARE_PROXY_TRUST=true
CLOUDFLARE_TUNNEL_URL=
SSL_ENABLED=false
SSL_PORT=443
SSL_KEY_PATH=certs/privkey.pem
SSL_CERT_PATH=certs/fullchain.pem

# ==============================================================================
# 2. MONGODB ATLAS (Cloud Document Database)
# ==============================================================================
MONGODB_URI=mongodb+srv://user_demo:password_demo@cluster0.abcde.mongodb.net/test-ai-system-jsts-db?retryWrites=true&w=majority

# ==============================================================================
# 3. NEO4J AURADB FREE TIER (Cloud Graph Database)
# ==============================================================================
NEO4J_URI=neo4j+s://12345678.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_aura_password_here

# ==============================================================================
# 4. CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible Storage)
# ==============================================================================
# Để trống S3_ENDPOINT nếu muốn chạy LOCAL FALLBACK MODE (lưu tại src/backend/storage)
S3_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_s3_or_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_or_r2_secret_access_key
S3_BUCKET_NAME=test-ai-system-storage
S3_REGION=auto

# ==============================================================================
# 5. BẢO MẬT XÁC THỰC (JWT) & MẬT MÃ
# ==============================================================================
JWT_ACCESS_SECRET=your_super_secret_access_key_at_least_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_at_least_32_characters_long
JWT_REFRESH_EXPIRATION=7d
SALT_ROUNDS=12
DATA_ENCRYPTION_KEY=your_64_hex_chars_aes_256_gcm_master_key_here

# ==============================================================================
# 6. GOOGLE GEMINI API (AI Engine Tier 3)
# ==============================================================================
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ==============================================================================
# 7. IN-APP REALTIME (WEBSOCKET / SOCKET.IO)
# ==============================================================================
SOCKET_ENABLED=true

# ==============================================================================
# 8. EMAIL ALERTING (SMTP VIA NODEMAILER)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Data Quality Platform <noreply@data-quality.local>"

# ==============================================================================
# 9. PUSH NOTIFICATION (NTFY.SH)
# ==============================================================================
NTFY_ENABLED=false
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=data_quality_alerts_demo
NTFY_ACCESS_TOKEN=
NTFY_REQUEST_TIMEOUT_MS=5000

# 10. Bootstrap (xóa hết DB + seed): CONFIRM_RESET=DROP_ALL_DATA pnpm run db:bootstrap
# =============================================================================
ORGANIZATION_ID=556d6a37bcf86cd799439013
OWNER_EMAIL=admin@school.local
OWNER_PASSWORD=Admin@123