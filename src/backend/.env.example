# ==============================================================================
# 1. CẤU HÌNH SERVER & ỨNG DỤNG
# ==============================================================================
PORT=3000
NODE_ENV=development
APP_NAME="AI Data Quality Platform"
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173
# URL gốc của ứng dụng web — dùng cho link trong email (lời mời workspace, xem báo cáo)
APP_URL=http://localhost:5173

# Cấu hình Cloudflare Zero Trust Tunnel & SSL/TLS (HTTPS Cổng 443)
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARE_PROXY_TRUST=true
CLOUDFLARE_TUNNEL_URL=
SSL_ENABLED=false
SSL_PORT=443
SSL_KEY_PATH=certs/privkey.pem
SSL_CERT_PATH=certs/fullchain.pem

# ==============================================================================
# 2. MONGODB ATLAS (Cloud Document Database)
# ==============================================================================
MONGODB_URI=mongodb+srv://user_demo:password_demo@cluster0.abcde.mongodb.net/test-ai-system-jsts-db?retryWrites=true&w=majority

# ==============================================================================

# ==============================================================================
# 4. CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible Storage)
# ==============================================================================
# Để trống S3_ENDPOINT nếu muốn chạy LOCAL FALLBACK MODE (lưu tại src/backend/storage)
S3_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_s3_or_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_or_r2_secret_access_key
S3_BUCKET_NAME=test-ai-system-storage
S3_REGION=auto

# ==============================================================================
# 5. BẢO MẬT XÁC THỰC (JWT) & MẬT MÃ
# ==============================================================================
JWT_ACCESS_SECRET=your_super_secret_access_key_at_least_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_at_least_32_characters_long
JWT_REFRESH_EXPIRATION=7d
# Hạn phiên khi chọn "ghi nhớ đăng nhập" (remember me)
JWT_REFRESH_REMEMBER_EXPIRATION=30d
SALT_ROUNDS=12
DATA_ENCRYPTION_KEY=your_64_hex_chars_aes_256_gcm_master_key_here

# ------------------------------------------------------------------------------
# ADMIN BOOTSTRAP (OPEN-01)
# ------------------------------------------------------------------------------
# Không có endpoint công khai để tự phong admin. Tài khoản admin được tạo
# MỘT LẦN khi ứng dụng khởi động, từ 2 biến dưới đây.
#
# - Bỏ trống cả hai → không tạo admin (hợp lệ ở môi trường dev).
# - Đã tồn tại admin với email này → KHÔNG ghi đè mật khẩu (idempotent).
# - Mật khẩu admin nên đủ mạnh; đổi mật khẩu qua `POST /auth/change-password`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ==============================================================================
# 6. GOOGLE GEMINI API (AI Engine Tier 3)
# ==============================================================================
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ==============================================================================
# 6b. GOOGLE OAUTH 2.0 — ĐĂNG NHẬP BẰNG GOOGLE (AUTH-03)
# ==============================================================================
# Cả 3 biến phải có đồng thời thì `GET /auth/google` mới hoạt động.
# Thiếu bất kỳ biến nào → endpoint trả 501 DEPENDENCY_UNAVAILABLE.
#
# LƯU Ý QUAN TRỌNG (2026-11-18): backend đăng ký middleware `cookie-parser` để đọc
# cookie HttpOnly `google_oauth_state` (đối chiếu CSRF ở `GET /auth/google/callback`).
# Cookie này KHÔNG dùng `SameSite=None` nên không cần cấu hình `SameSite`/`Secure` ở đây —
# `secure` được suy ra từ `req.secure` (tôn trọng `trust proxy` khi qua Cloudflare Tunnel).
# Nếu đăng nhập Google báo 401 "Phiên đăng nhập Google không hợp lệ", kiểm tra:
#   - `main.ts` có `app.use(cookieParser())` không (bắt buộc),
#   - `CLOUDFLARE_PROXY_TRUST=true` khi chạy qua tunnel để `req.secure` đúng,
#   - `GOOGLE_REDIRECT_URI` khớp chính xác với URI đã đăng ký ở Google Console.
#
# Cách lấy credential:
#   1. Vào https://console.cloud.google.com/apis/credentials
#   2. Tạo "OAuth 2.0 Client ID" > loại "Web application"
#   3. Thêm Authorized redirect URI, ví dụ:
#        http://localhost:3000/api/v1/auth/google/callback   (dev)
#        https://<your-domain>/api/v1/auth/google/callback  (prod — Google BẮT BUỘC HTTPS)
#   4. Dán Client ID / Client Secret vào dưới đây
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# ==============================================================================
# 7. IN-APP REALTIME (WEBSOCKET / SOCKET.IO)
# ==============================================================================
SOCKET_ENABLED=true

# ------------------------------------------------------------------------------
# 7b. REDIS — bắt buộc cho MULTI-INSTANCE (realtime + cache + rate-limit)
# ------------------------------------------------------------------------------
# Khi REDIS_URL có giá trị, backend gắn Socket.IO Redis adapter → nhiều instance
# (nhiều pod/container) broadcast cùng event realtime cho mọi client đang kết nối.
# Khi trống hoặc Redis không kết nối được → fallback về adapter `memory`
# (single-instance, KHÔNG crash app, có log cảnh báo rõ ràng).
#
# Dùng mật khẩu riêng qua REDIS_PASSWORD thay vì nhúng vào URL
# (tránh lộ secret trong log/giám sát).
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=dq:

# ==============================================================================
# 7c. EVENT BUS (KAFKA) + WORKER
# ==============================================================================
# KAFKA_BROKERS trống  → event bus chạy chế độ `in-process` (đơn instance).
# KAFKA_BROKERS có giá trị → event bus chạy chế độ `kafka` (đa instance).
#   Kafka là hạ tầng bên ngoài; backend chỉ cần danh sách broker, phân tách bằng dấu phẩy.
#
#   docker run -d --name kafka -p 9092:9092 \
#     -e KAFKA_NODE_ID=1 -e KAFKA_PROCESS_ROLES=broker,controller \
#     -e KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093 \
#     -e KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092 \
#     -e KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093 \
#     -e KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER \
#     -e KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT \
#     -e KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1 -e KAFKA_LOG_DIRS=/tmp/kraft-combined-logs \
#     apache/kafka:3.7.0
KAFKA_BROKERS=

# ------------------------------------------------------------------------------
# WORKER — tách API process và worker process (PDF/AI/relay)
# ------------------------------------------------------------------------------
# WORKER_MODE:
#   api    → chỉ chạy HTTP API, KHÔNG chạy worker nền (dùng khi tách riêng)
#   worker → chỉ chạy worker nền, KHÔNG nhận HTTP traffic
#   all    → chạy cả hai (mặc định — dev/đơn instance)
WORKER_MODE=all

# REPORT_WORKER_ENABLED — worker sinh file PDF báo cáo Tổng kết.
#   false → POST /projects/:projectId/report trả 202 và chờ; PDF chỉ có khi bật.
#   true  → worker quét mỗi 10s, sinh PDF, upload lên storage, sẵn sàng tải về.
# Bắt buộc bật (true) nếu muốn tính năng xuất báo cáo PDF hoạt động đầy đủ.
REPORT_WORKER_ENABLED=true

# AI_WORKER_INTERVAL_MS — chu kỳ quét job AI (ms).
AI_WORKER_INTERVAL_MS=10000

# ------------------------------------------------------------------------------
# GĐ0 — CHỐNG QUÁ TẢI MÁY KHI PHÂN TÍCH AI
# ------------------------------------------------------------------------------
# ANALYSIS_MAX_ROWS — ngưỡng tối đa số dòng dataset cho phép phân tích đồng bộ.
#   Dataset có rowCount > ngưỡng sẽ bị từ chối với HTTP 413 (ANALYSIS_TOO_LARGE)
#   TRƯỚC khi đọc bất kỳ record nào từ MongoDB.
#   Lý do: nạp toàn bộ dataset vào RAM tạo peak-memory vài GB → OOM / quá nhiệt CPU.
#   Mặc định 50.000 dòng (GĐ11 — đo được peak RSS 568 MB trên dataset 100.000 dòng thật).
ANALYSIS_MAX_ROWS=50000

# ANALYSIS_MAX_CONCURRENCY — GĐ12: số phân tích ĐỒNG BỘ tối đa chạy cùng lúc
#   trong một tiến trình. POST /projects/:id/analysis xử lý inline trong request
#   → mỗi lần chặn event loop ~6s với dataset 100.000 dòng. Nếu không giới hạn,
#   các request phân tích xếp hàng và MỌI endpoint khác của cùng instance chậm theo
#   (đo được: p95 GET /records nhảy 21ms → 3,23s khi 10 VU gọi đồng thời).
#   Khi đã đủ slot → HTTP 429 (LIMIT_EXCEEDED) kèm Retry-After.
#   Lưu ý: giới hạn trên MỖI instance — chạy N replica thì tổng = N × giá trị này.
ANALYSIS_MAX_CONCURRENCY=1

# AI_RAM_GUARD_PERCENT — ngưỡng % RAM hệ thống đã dùng thì chặn job AI mới.
AI_RAM_GUARD_PERCENT=90

# AI_MIN_RAM_GB — ngưỡng RAM khả dụng tối thiểu (GB) để nhận job AI mới.
AI_MIN_RAM_GB=4

# OUTBOX_RELAY_ENABLED — relay outbox sang event bus (Kafka/in-process).
OUTBOX_RELAY_ENABLED=true

# ==============================================================================
# 8. EMAIL ALERTING (SMTP VIA NODEMAILER)
# ==============================================================================
# Dùng Gmail: bật 2FA → tạo App Password (16 ký tự) tại
# https://myaccount.google.com/apppasswords → dán vào SMTP_PASS (bỏ khoảng trắng).
# Thiếu cấu hình → adapter fail an toàn (log cảnh báo, không crash app).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Data Quality Platform <noreply@data-quality.local>"

# ==============================================================================
# 9. PUSH NOTIFICATION (NTFY.SH)
# ==============================================================================
# Topic là kênh công khai — dùng token để giữ bí mật:
# https://ntfy.sh/<topic> → "Create token" → Access token.
NTFY_ENABLED=false
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=data_quality_alerts_demo
NTFY_ACCESS_TOKEN=
NTFY_REQUEST_TIMEOUT_MS=5000

# 10. Bootstrap (xóa hết DB + seed): CONFIRM_RESET=DROP_ALL_DATA pnpm run db:bootstrap
# =============================================================================
ORGANIZATION_ID=556d6a37bcf86cd799439013
OWNER_EMAIL=admin@school.local
OWNER_PASSWORD=Admin@123