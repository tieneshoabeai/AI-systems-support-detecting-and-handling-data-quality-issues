{
  "name": "ai-data-quality-backend",
  "version": "1.1.0",
  "description": "AI-Driven Data Quality Management & Remediation Platform Backend (Zod & Shared Architecture)",
  "author": "Data Quality Team",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "type-check": "tsc --noEmit",
    "tunnel": "ngrok http 3000",
    "db:seed": "ts-node scripts/seed-initial-data.ts",
    "db:bootstrap": "ts-node scripts/bootstrap-database.ts",
    "db:reset:all": "TARGET=all ts-node scripts/bootstrap-database.ts",
    "db:reset:mongo": "TARGET=mongo ts-node scripts/bootstrap-database.ts",
    "db:reset:neo4j": "TARGET=neo4j ts-node scripts/bootstrap-database.ts",
    "db:reset:storage": "TARGET=storage ts-node scripts/bootstrap-database.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.670.0",
    "@aws-sdk/lib-storage": "^3.670.0",
    "@casl/ability": "^7.0.2",
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.21",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/throttler": "^6.4.0",
    "bcrypt": "^5.1.1",
    "busboy": "^1.6.0",
    "dotenv": "^16.4.5",
    "fast-csv": "^5.0.2",
    "helmet": "^8.0.0",
    "mongoose": "^9.6.2",
    "neo4j-driver": "^5.25.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.21",
    "@types/bcrypt": "^5.0.2",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.16.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "jest": "^30.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
