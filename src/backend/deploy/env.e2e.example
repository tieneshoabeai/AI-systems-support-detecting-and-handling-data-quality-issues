# Sao chép thành deploy/.env.e2e (không commit) rồi điền các biến cần ghi đè.
# Biến không điền sẽ dùng giá trị mặc định trong docker-compose.e2e.yml.

# --- Lưu trữ đám mây (bỏ trống → lưu cục bộ trong volume) ---
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto

# --- AI (cần --profile ai) ---
AI_WORKER_ENABLED=false
AI_MODEL_ID=

# --- Dịch vụ phụ (bật khi demo) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NTFY_ENABLED=false
NTFY_TOPIC=
NTFY_ACCESS_TOKEN=
