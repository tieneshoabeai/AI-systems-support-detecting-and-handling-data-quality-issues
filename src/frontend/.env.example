VITE_API_BASE_URL=https://your-backend-host.example
VITE_API_PREFIX=/api/v1
# Keep this stable when only the temporary backend tunnel URL changes.
VITE_API_ENVIRONMENT_ID=qa-main
# Optional comma-separated old Swagger URLs or API base URLs explicitly confirmed
# to point to this same environment. Old IndexedDB rows are retained if not listed.
VITE_API_MIGRATE_FROM=
# api (default) uses the existing authenticated application; mock is for UI review only.
VITE_MANAGEMENT_DATA_MODE=api

# HTTPS is the default. Set DEV_HTTPS=false for HTTP local UI review on port 5173.
# Use HTTPS when verifying authentication against the deployed backend.
# Generate local development files with npm run dev:cert (PowerShell 7 on Windows).
# For browser testing, point these at a certificate trusted on your machine.
DEV_HTTPS_KEY=certs/localhost-key.pem
DEV_HTTPS_CERT=certs/localhost.pem
