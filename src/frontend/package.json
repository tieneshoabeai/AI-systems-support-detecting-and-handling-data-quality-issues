{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "allowScripts": {
    "@ybouane/liquidglass": false
  },
  "scripts": {
    "gen:types": "node scripts/generate-swagger-types.mjs",
    "dev": "vite",
    "dev:cert": "node scripts/generate-dev-cert.mjs",
    "dev:e2e": "vite --config vite.e2e.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "typecheck:perf": "tsc -p tests/performance/tsconfig.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "5.104.5",
    "@ybouane/liquidglass": "1.0.3",
    "axios": "1.20.0",
    "dexie": "4.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stylistic/eslint-plugin": "6.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/k6": "2.3.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "18.0.10",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "6.2.6",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  }
}
